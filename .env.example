# CiteVyn local environment template.
#
# Copy to `.env` (which is git-ignored) and adjust as needed. Values
# shown match the defaults baked into `app.core.config.Settings`.

# ── The single most consequential variable in this file ──────────────
# Deployment mode. "production" is not a label — it is the flag that
# turns on every hardening guard in the app, and ANY other value (the
# default included) leaves them all off. An operator who does not know
# this variable exists ships development-mode behaviour to the public
# internet with no error and no warning.
#
# What `production` switches on (each verified against a read site):
#   * `/docs`, `/redoc` and the OpenAPI schema are withdrawn  (app/main.py)
#   * HSTS is sent                        (app/core/security_headers.py)
#   * the session cookie gets `Secure` and the `__Host-` name prefix
#                                            (app/core/auth_sessions.py)
#   * a `stub` LLM or embedding provider is REFUSED at startup, so the
#     demo cannot silently serve canned answers  (app/llm/factory.py,
#     app/embeddings/factory.py)
#   * the published default DEMO and ADMIN keys are REFUSED, as is a
#     demo or admin key under 16 characters         (app/core/config.py)
#     — and only those two. No other credential is strength-checked at
#     all: the OAuth pair gets a both-or-neither check, the LLM keys a
#     presence check, and CITEVYN_RESEND_API_KEY is fully optional (only
#     its COMPANIONS are required once it is set). A four-character
#     OAuth or Resend key starts up fine. Do not read this as "weak
#     secrets are caught"; it catches exactly two of them.
#   * the dev file outbox for emails is withdrawn: with no Resend key
#     there is no email client at all, and a SET outbox dir is refused
#     at startup, so magic links cannot silently go to a local file
#     nobody reads   (app/services/notifications.py, app/core/config.py)
#
# The two shipped deployment paths set this for you — `fly.toml` and
# `infra/docker/docker-compose.yml` both pin it to `production`. Any
# OTHER way of starting the app (a bare `uvicorn`, another
# orchestrator, a one-off container) gets `local` unless you set it
# here, which is why it is written down rather than left implicit.
CITEVYN_ENVIRONMENT=local

# Demo bearer token required for non-admin endpoints.
CITEVYN_DEMO_API_KEY=local-demo-key

# Admin key for /internal/v1/* endpoints (ingestion, index promotion).
CITEVYN_ADMIN_API_KEY=local-admin-key

# Async SQLAlchemy URL. SQLite (aiosqlite) is used in tests; the
# recommended local development URL points at the docker-compose
# `db` service.
CITEVYN_DATABASE_URL=postgresql+psycopg://citevyn:citevyn@localhost:5432/citevyn

# Optional database settings.
CITEVYN_DATABASE_ECHO=false
CITEVYN_DATABASE_POOL_SIZE=5

# Header used to propagate a request identifier (incoming or generated).
CITEVYN_REQUEST_ID_HEADER=X-Request-ID

# Optional: enable the `postgres` pytest marker against a real Postgres
# server (e.g. `uv run pytest -m postgres`). When unset, those tests
# are skipped with an explicit reason so the default `uv run pytest`
# flow stays hermetic against in-memory SQLite.
# CITEVYN_PG_TEST_URL=postgresql+psycopg://citevyn:citevyn@localhost:5432/citevyn_pg_test

# Slice 3 — answer generation. `stub` is the default; switch to
# `anthropic` to enable live `AnthropicMessagesClient` calls. The
# env var names match the Settings field names (``anthropic_*`` →
# ``CITEVYN_ANTHROPIC_*`` via the env_prefix).
# CITEVYN_LLM_PROVIDER=stub
# CITEVYN_LLM_MODEL=claude-opus-4-8
# CITEVYN_LLM_MAX_TOKENS=1024
# CITEVYN_LLM_TEMPERATURE=0.2
# CITEVYN_ANTHROPIC_API_KEY=...            # required only when LLM_PROVIDER=anthropic
# CITEVYN_ANTHROPIC_API_BASE=https://api.anthropic.com
# CITEVYN_ANTHROPIC_API_VERSION=2023-06-01
# CITEVYN_ANTHROPIC_TIMEOUT_SECONDS=30.0

# Slice 9b — Gemini + OpenRouter providers (real, non-stub answers).
# Set CITEVYN_LLM_PROVIDER=gemini to use Gemini Flash (free tier) as the primary
# and OpenRouter as an automatic fallback (on Gemini error / when only the
# OpenRouter key is set). Set CITEVYN_LLM_PROVIDER=router to route straight to
# OpenRouter. Provide whichever key(s) you have; keep them out of version
# control (this file is git-ignored once copied to `.env`).
# Cost priority (#99): Gemini Flash primary is the free tier (~$0); GPT-4o-mini
# on OpenRouter is the paid backstop, from a different provider family so one
# Google model retirement cannot take out both arms.
# CITEVYN_LLM_PROVIDER=gemini
# CITEVYN_GEMINI_API_KEY=...                # Google AI Studio key (x-goog-api-key)
# CITEVYN_GEMINI_MODEL=gemini-flash-latest  # auto-tracks current Flash GA (2.5-flash retired for new projects)
# CITEVYN_GEMINI_API_BASE=https://generativelanguage.googleapis.com
# CITEVYN_GEMINI_TIMEOUT_SECONDS=30.0
# CITEVYN_GEMINI_THINKING_BUDGET=0          # 0 disables "thinking" (right for Flash doc answers — spends the token budget on the answer). -1 = dynamic; a positive value for a model that requires thinking.
# CITEVYN_OPENROUTER_API_KEY=...            # OpenRouter key (Bearer)
# CITEVYN_OPENROUTER_MODEL=openai/gpt-4o-mini    # paid fallback (priority-2)
# CITEVYN_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# CITEVYN_OPENROUTER_TIMEOUT_SECONDS=30.0

# Slice 3 — embeddings.
# CITEVYN_EMBEDDING_PROVIDER=stub
# CITEVYN_EMBEDDING_MODEL=voyage-3
# CITEVYN_EMBEDDING_DIM=1024
# CITEVYN_EMBEDDING_TIMEOUT_SECONDS=15.0    # per-request HTTP timeout for the embedder
# CITEVYN_EMBEDDING_MAX_RETRIES=2           # retries on a transient embedder error (0 = none)

# Slice 4 — retrieval & answer engine.
# CITEVYN_RETRIEVAL_TOP_K=6
# CITEVYN_RETRIEVAL_MAX_CANDIDATES=20
# CITEVYN_ANSWER_POLICY_VERSION=v2
# CITEVYN_CACHE_TTL_SECONDS=86400
# CITEVYN_CACHE_ENABLED=true
# CITEVYN_UNSUPPORTED_REFUSAL="I can answer questions about Claude, Claude Code, Codex, and Gemini using indexed official documentation. I do not have credible source material in this assistant to answer that."
# CITEVYN_NO_ANSWER_FALLBACK="I do not have credible source material in this assistant to answer that."
# CITEVYN_INDEX_SESSION_TTL_SECONDS=86400
# (CITEVYN_FIXTURES_ROOT was removed in #92 — the worker's source docs ship as
#  package data under app/worker/sources; there is no external fixtures path to set.)

# Phase 2 — "answer when grounded". A question that names no product routes to
# `unsupported`; instead of refusing immediately we retrieve GLOBALLY and answer
# when the evidence is confident. Set false to restore refuse-before-retrieval.
# The two thresholds below are the confidence gate that makes that safe: an
# off-corpus query's nearest chunk is either weak (below the score floor) or one
# of a muddle of near-equal matches (below the margin). LOWERING them lets
# off-corpus questions through to the LLM, so treat a change as an answer-quality
# change and re-run `make eval` — they were tuned against measured margins
# (answerable >= 0.070, refusal <= 0.027).
# CITEVYN_ANSWER_WHEN_GROUNDED=true
# CITEVYN_RETRIEVAL_GLOBAL_MIN_TOP_SCORE=0.30
# CITEVYN_RETRIEVAL_GLOBAL_MIN_MARGIN=0.04

# Phase 3b — conversation memory. Rewrites an anaphoric follow-up ("How can I
# raise it?") against recent turns so retrieval and the answer both see the
# topic. `memory_recent_turns` bounds how far back the antecedent is looked for.
# CITEVYN_CONVERSATION_MEMORY=true
# CITEVYN_MEMORY_RECENT_TURNS=6

# #84 follow-up — CiteVyn alias intent check. Single-token manglings ("sitewin")
# are caught deterministically; the two-word homophones ("site win") are ordinary
# English, so they get a short LLM intent check instead — only on a message that
# actually contains "site|cite|sight win", which is essentially never in normal
# traffic. Set false to disable (such a question then refuses as it did before).
#
# NOTE THE DOUBLED PREFIX, IT IS NOT A TYPO. The Settings field is named
# `citevyn_alias_intent_check` and `env_prefix` is `CITEVYN_`, so the variable is
# CITEVYN_CITEVYN_ALIAS_INTENT_CHECK. `CITEVYN_ALIAS_INTENT_CHECK` sets nothing
# — `extra="ignore"` means it is silently dropped and the check stays ON.
# CITEVYN_CITEVYN_ALIAS_INTENT_CHECK=true

# §9 cost controls (#153). The daily dollar ceilings are summed in SQL from
# `provider_calls` since midnight UTC, so they survive a restart. The three knobs
# here are the ones that decide whether that meter is honoured at all:
#   *_ENABLED=false      turns the whole daily budget OFF — no spend ceiling.
#   *_FAIL_CLOSED=false  makes an UNREADABLE meter fail OPEN, i.e. an unmetered
#                        spending window whose only ceiling is the provider's.
#   *_MAX_CONCURRENT     bounds paid calls IN FLIGHT at once; without it a burst
#                        outruns the daily budget's ability to observe it.
# CITEVYN_COST_BUDGET_ENABLED=true
# CITEVYN_COST_BUDGET_FAIL_CLOSED=true
# CITEVYN_COST_MAX_CONCURRENT_CALLS=8
# CITEVYN_COST_SOFT_DAILY_USD=5.0
# CITEVYN_COST_HARD_DAILY_USD=10.0

# Index promotion gate (docs/RELEASE_PLAN.md §7, gate 1). `promote_version`
# refuses to make a candidate index live unless its newest COMPLETED evaluation
# run scored at least this pass rate; no usable run also means refuse
# ("unevaluated" is not "passing"). Equality promotes. Lowering this lets a
# worse index go live, so it is an operator decision, not a tuning constant.
# CITEVYN_INDEX_PROMOTION_MIN_PASS_RATE=0.95

# Slice 9a — Redis-backed sliding-window rate limiter.
# Uncomment to enable. When unset, the in-process limiter is used
# (per-process, under-counts under multi-worker uvicorn). Production
# MUST set CITEVYN_REDIS_URL so the Redis path is active.
# CITEVYN_REDIS_URL=redis://localhost:6379/0
# CITEVYN_REDIS_KEY_PREFIX=citevyn:rl
# CITEVYN_RATE_LIMIT_ENABLED=true
# CITEVYN_RATE_LIMIT_WINDOW_SECONDS=3600
# CITEVYN_RATE_LIMIT_DEMO_USER_PER_HOUR=30
# CITEVYN_RATE_LIMIT_ADMIN_PER_HOUR=1000
# A SIGNED-IN caller gets this ceiling instead of the anonymous 30/h above,
# keyed on their own user_id — this is what makes the pricing page's "sign in
# for a higher limit" structurally true rather than copy alone (ADR-0004 PR 11).
# CITEVYN_RATE_LIMIT_DEMO_USER_REGISTERED_PER_HOUR=100
# Credential-stuffing throttle on POST /v1/auth/login, keyed per TARGET EMAIL
# (not per client IP — a distributed attacker trying one password across 200
# source addresses against ONE account must still be stopped, and an IP-keyed
# bucket lets exactly that through). `register` shares this bucket, keyed on the
# address being claimed. Deliberately far below the general demo limit: it
# exists to slow credential stuffing, not to carry ordinary traffic.
# CITEVYN_RATE_LIMIT_AUTH_LOGIN_PER_HOUR=10

# ADR-0004 PR 14 — magic-link login + transactional email.
# With no CITEVYN_RESEND_API_KEY, local/dev writes each email to a file under
# CITEVYN_EMAIL_OUTBOX_DIR (default: <system temp dir>/citevyn_email_outbox) —
# copy the link out of the newest file there. Production needs the real key
# (+ a From: on a Resend-verified domain, + the public base URL); the outbox
# is refused in production. Never commit a real key.
# CITEVYN_RESEND_API_KEY=re_...
# CITEVYN_EMAIL_FROM="CiteVyn <login@example.com>"
# CITEVYN_MAGIC_LINK_BASE_URL=https://citevyn.stackclimb.com   # EXACT origin the browser uses (scheme+host+port, no path); the confirm POST's Origin must match it
# CITEVYN_EMAIL_OUTBOX_DIR=/tmp/citevyn_email_outbox
# CITEVYN_MAGIC_LINK_TTL_SECONDS=600
# CITEVYN_RATE_LIMIT_PASSWORD_CHANGE_PER_HOUR=3   # per-user cap on current-password-supplied changes (recovery set exempt)
# CITEVYN_PASSWORD_STEP_UP_WINDOW_SECONDS=600   # same-session "set a new password without the old one" window after a magic-link sign-in
# CITEVYN_RATE_LIMIT_MAGIC_LINK_PER_HOUR=5
# CITEVYN_RATE_LIMIT_MAGIC_LINK_INTERVAL_SECONDS=60   # minimum gap between two link requests for ONE address; a FLOOR, separate bucket from the hourly ceiling above
# Session cookie lifetime AND the `auth_sessions` row expiry (ADR-0004 PR 3).
# 180 days by default: long enough that a returning anonymous visitor keeps
# their pseudonymous identity across normal browsing gaps, short enough that an
# abandoned or stolen cookie does not grant access forever. Shorten it locally
# to exercise expiry paths.
# CITEVYN_AUTH_SESSION_TTL_SECONDS=15552000

# ADR-0004 PR 12 + PR 13 — GitHub / Google OAuth login and account linking.
# Unset by default, and everything FAILS CLOSED: `Settings` refuses a provider
# configured with only one of id/secret, and refuses a missing redirect base in
# production once any provider is configured. But the sign-in modal and the
# connected-accounts drawer render BOTH provider buttons unconditionally, and an
# unconfigured provider 404s — so leaving these unset gives dead buttons, which
# is why they are written down here rather than only in the code.
#
# The callback URL is derived, never taken from the request Host: it is always
# <CITEVYN_OAUTH_REDIRECT_BASE_URL>/v1/auth/oauth/{provider}/callback, and that
# exact URL must be registered with the provider. See docs/API_SPEC.md 4b.
# CITEVYN_GITHUB_OAUTH_CLIENT_ID=
# CITEVYN_GITHUB_OAUTH_CLIENT_SECRET=
# CITEVYN_GOOGLE_OAUTH_CLIENT_ID=
# CITEVYN_GOOGLE_OAUTH_CLIENT_SECRET=
# CITEVYN_OAUTH_REDIRECT_BASE_URL=https://citevyn.stackclimb.com   # scheme+host, no path; REQUIRED in production once a provider is set
# CITEVYN_OAUTH_CONNECT_MAX_SESSION_AGE_SECONDS=1200   # how fresh a session must be to LINK a provider to an existing account (default 20 min)
