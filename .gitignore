# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
# Also a SYMLINK named .venv or node_modules (a worktree sharing the main
# checkout's environment): a trailing slash matches only directories.
.venv
venv/

# Environment: every .env-prefixed name (.env, .env.local, .env~, .env-old,
# .envrc, ...), except the tracked templates. docs/ENVIRONMENT_FILES.md.
.env*
!.env.example

# IDE / OS
.DS_Store
.idea/
.vscode/

# Claude Code agent state (per-machine; not part of the project)
# Local Claude Code config stays out of git (settings.local.json with your
# permissions and plugins, local skills) — EXCEPT the shared, committed
# `.claude/settings.json` (hooks only) and the `rag-eval` and
# `citevyn-delivery` project skills.
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/rag-eval/
!.claude/skills/citevyn-delivery/

# Logs
*.log
logs/

# Build
dist/
build/

# Node, if frontend is added later
node_modules/
node_modules
.next/
coverage/
# frontend/ — node_modules and build artefacts only; source files are tracked
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Docker/local data
*.db
*.sqlite
data/
tmp/

# Production runtime artefacts (volumes are bind-mounted; data
# is owned by the host user, not the repo).
infra/docker/backups/citevyn-*.dump
infra/docker/caddy_data/
infra/docker/caddy_config/
infra/docker/citevyn_pgdata/

# Playwright live-mode report dir
playwright-report-live/

# Generated eval / golden run reports (make eval / make golden write here)
artifacts/

# Local live-verification symlink to the built frontend (see docs/archive/2026-10/NEXT_SESSION_PROMPT.md); never commit it.
backend/frontend_dist
