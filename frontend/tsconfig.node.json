{
  "compilerOptions": {
    "composite": true,
    // #343: `composite` FORCES emit, and without an outDir `tsc -b` wrote
    // `vite.config.js` next to `vite.config.ts` in the frontend root. Vite's
    // DEFAULT_CONFIG_FILES (node_modules/vite/dist/node/constants.js) lists
    // `vite.config.js` BEFORE `vite.config.ts`, so `npm run dev` and
    // `npm run preview` — neither of which runs `tsc -b` first — loaded the
    // compiled copy, and `npm run dev` is what playwright.config.ts's
    // webServer.command runs. Sending the emit to a scratch dir keeps the
    // project-reference bookkeeping (tsconfig.json references this project for
    // build ordering only; nothing under src/ or e2e/ imports these modules)
    // while removing the whole class of staleness.
    // src/test/buildGuards.test.ts asserts this holds.
    "outDir": "node_modules/.tmp/tsnode",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "playwright.live.config.ts", "playwright.demo-ci.config.ts", "vite.liveStub.ts"]
}
